{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/ander/.claude/resources/ecc-library/hooks/scripts/detect-new-file-pre.js\""
          }
        ],
        "description": "Detect whether a Write targets a not-yet-existing file",
        "id": "always:pre:detect-new-file"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/ander/.claude/resources/ecc-library/hooks/scripts/track-new-file-post.js\""
          }
        ],
        "description": "Record newly created files under the current phase heading in New_files.md",
        "id": "always:post:track-new-file"
      }
    ]
  }
}
