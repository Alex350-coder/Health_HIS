{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege baseline (Rules.md 8.1, Security.md Section 9). The main window is granted only the core webview permissions required to render the app. No filesystem, shell, http, dialog or clipboard permission is granted. Application commands are added here explicitly, one at a time, as each phase introduces them.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-auth-bootstrap-status",
    "allow-auth-bootstrap-admin",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-auth-current-user",
    "allow-auth-create-user",
    "allow-auth-list-users",
    "allow-auth-deactivate-user",
    "allow-audit-list",
    "allow-audit-verify-integrity",
    "allow-patients-create",
    "allow-patients-update",
    "allow-patients-get",
    "allow-patients-list",
    "allow-medical-history-create-encounter",
    "allow-medical-history-discharge-encounter",
    "allow-medical-history-get-by-patient",
    "allow-medical-history-create-diagnosis",
    "allow-medical-history-create-treatment",
    "allow-medical-history-create-evolution",
    "allow-hospital-map-get-layout",
    "allow-hospital-map-get-room-status",
    "allow-beds-create-floor",
    "allow-beds-create-room",
    "allow-beds-create",
    "allow-beds-set-status"
  ]
}
